<Project>
  <!--
    Shared settings for every project in the solution.

    1. LyricistTargetFramework: the ONE line to change if DevExpress 21.2 misbehaves on .NET 10.
       net48 (.NET Framework 4.8, same as the DumbAngel prototype) or net10.0-windows.
       20 Nov 2026: on net10.0-windows, DevExpress 21.2's XtraForm crashes at start-up
       (FormIconHelper type initializer, NullReferenceException): 21.2 predates .NET 10.

    2. DevExpressRoot: where DevExpress 21.2 is installed. Check it matches your machine
       (your prototype project's DevExpress references show the real path). Directory.Build.targets
       picks the Framework or NetCore folder under it to suit the target framework. To point
       straight at a folder instead, set DevExpressBin here.
  -->
  <PropertyGroup>
    <LyricistTargetFramework>net48</LyricistTargetFramework>
    <DevExpressVersion>v21.2</DevExpressVersion>
    <DevExpressRoot>D:\Program Files (x86)\DevExpress 21.2\Components\Bin</DevExpressRoot>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
</Project>
