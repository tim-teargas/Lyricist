<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(LyricistTargetFramework)</TargetFramework>
    <RootNamespace>Lyricist.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DevExpress.Data.$(DevExpressVersion)">
      <HintPath Condition="Exists('$(DevExpressBin)\DevExpress.Data.$(DevExpressVersion).dll')">$(DevExpressBin)\DevExpress.Data.$(DevExpressVersion).dll</HintPath>
      <HintPath Condition="!Exists('$(DevExpressBin)\DevExpress.Data.$(DevExpressVersion).dll')">$(DevExpressStdBin)\DevExpress.Data.$(DevExpressVersion).dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Xpo.$(DevExpressVersion)">
      <HintPath Condition="Exists('$(DevExpressBin)\DevExpress.Xpo.$(DevExpressVersion).dll')">$(DevExpressBin)\DevExpress.Xpo.$(DevExpressVersion).dll</HintPath>
      <HintPath Condition="!Exists('$(DevExpressBin)\DevExpress.Xpo.$(DevExpressVersion).dll')">$(DevExpressStdBin)\DevExpress.Xpo.$(DevExpressVersion).dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Pronunciation dictionaries and thesaurus: copied to WordData\ next to the exe. -->
  <ItemGroup>
    <None Update="WordData\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- On .NET (not Framework) XPO's SQL Server provider needs the client library as a package. -->
  <ItemGroup Condition="!$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>

</Project>
